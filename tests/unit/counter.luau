-- Tests for conversion of Unciv models/Counter.kt at
-- revision 42939c6a2cf31aa76f44ffc033015ad12fece9f5.
local Counter = require("../../src/models/Counter")
local c = Counter.new()
assert(Counter.get(c, "absent") == 0 and not Counter.containsKey(c, "absent"))
assert(Counter.put(c, "gold", 4) == nil)
assert(Counter.put(c, "food", -2) == nil)
assert(Counter.put(c, "gold", 3) == 4)
assert(Counter.sumValues(c) == 1)
assert(Counter.entries(c)[1].key == "gold")
Counter.add(c, "food", 2)
assert(not Counter.containsKey(c, "food"))
assert(Counter.put(c, "gold", 0) == 3)
assert(#Counter.entries(c) == 0)
assert(Counter.put(c, "missing", 0) == nil)
assert(Counter.removeKey(c, "missing") == nil)

local base = Counter.new({{key = "a", value = 2}, {key = "b", value = -1}})
local cloned = Counter.clone(base)
Counter.add(cloned, "a", 3)
assert(Counter.get(base, "a") == 2 and Counter.get(cloned, "a") == 5)
local delta = Counter.new({{key = "a", value = -2}, {key = "c", value = 4}})
local sum = Counter.plus(base, delta)
assert(Counter.get(sum, "a") == 0 and not Counter.containsKey(sum, "a"))
assert(Counter.entries(sum)[1].key == "b" and Counter.entries(sum)[2].key == "c")
assert(Counter.get(base, "a") == 2 and Counter.get(delta, "a") == -2)
Counter.remove(sum, delta)
assert(Counter.get(sum, "a") == 2 and Counter.get(sum, "c") == 0)
local scaled = Counter.times(base, -3)
assert(Counter.get(scaled, "a") == -6 and Counter.get(scaled, "b") == 3)
assert(#Counter.entries(Counter.times(base, 0)) == 0)
Counter.addCounter(base, base)
assert(Counter.get(base, "a") == 4 and Counter.get(base, "b") == -2)
Counter.remove(base, base)
assert(#Counter.entries(base) == 0)

-- Constructor preserves zero entries, matching the upstream super.put path.
local zeros = Counter.new({{key = "zero", value = 0}, {key = "other", value = 1}})
assert(Counter.containsKey(zeros, "zero"))
assert(Counter.containsKey(Counter.clone(zeros), "zero"))
Counter.add(zeros, "zero", 0)
assert(not Counter.containsKey(zeros, "zero"))
Counter.put(zeros, "zero", 2)
assert(Counter.entries(zeros)[2].key == "zero")
local snapshot = Counter.entries(zeros)
snapshot[1].value = 100
assert(Counter.get(zeros, "other") == 1)

assert(not pcall(Counter.put, zeros, "bad", 1.5))
assert(not pcall(Counter.put, zeros, "bad", math.huge))
assert(not pcall(Counter.put, zeros, "bad", 0/0))
assert(not pcall(Counter.put, zeros, "bad", 9007199254740992))
assert(not pcall(Counter.times, zeros, 1.5))
assert(not pcall(Counter.put, Counter.ZERO, "a", 1))
assert(not pcall(Counter.removeKey, Counter.ZERO, "absent"))
local mutableZero = Counter.clone(Counter.ZERO)
Counter.add(mutableZero, "a", 1)
assert(Counter.get(Counter.ZERO, "a") == 0 and Counter.get(mutableZero, "a") == 1)
print("counter: passed")
